  # ── S43 DOCKET (filed 2026-08-24 at close, all gate: LOCKED, none fixed in-sprint) ──
  S43-F01: GuardianSchemaNeverAppliedLiveDatasource  # HIGH — wc_guardians absent from the LIVE datasource;
                                                #   /api/guardians + /drift 500. The T04/T05 columns from the SAME
                                                #   db-setup.sql ARE applied, so it is the guardian half specifically.
