###############################################################################
# IN-REPO KNOWLEDGE (pull via MCP when coding)
###############################################################################

mcp:
  endpoint: http://localhost:3000/mcp
  start: cd docs && bun --bun nuxt dev
  key-slugs:
    - layer-cascade
    - feature-knowledge
    - organization-planning
    - todo
    - in-repo-planning
    - runtime-config
    - authentication
    - integrations
    - work-control

upstream-knowledge: core/docs/knowledge/
upstream-adrs: core/docs/adr/  # archived — prefer MCP explain()

###############################################################################
# PORTS
###############################################################################

ports:
  docs: 3000
  control: 3001
  chat-app: 3002
  work-control: 3003
  todo: 3004
  demo-dashboard: 3010
  demo-saas: 3011
  demo-landing: 3012
  demo-chat: 3013
  demo-characters: 3014
  # S41-F01: the scaffolder no longer hard-caps at 3009.
  customer-window: 3002-3099        # nextAppPort walks this range, first genuinely free port wins
  reserved: [3000, 3001, 3010, 3011, 3012, 3013, 3014]   # never allocated to a customer app
  note: AGENTS.md still documents the OLD 3002-3009 window and omits 3014 — code is authoritative

