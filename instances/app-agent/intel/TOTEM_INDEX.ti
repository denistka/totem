###############################################################################

project:
  name: app-agent
  codename: tech-company-in-a-box
  tagline: Describing your product makes it exist
  repo: https://github.com/denistka/DAWWWB-app-agent
  upstream: https://github.com/app-agent-io/core
  code: ../../../../app-agent-io/DAWWWB-app-agent-dev   # LIVE target (branch write-docs-in-auto) — see agent-rules mismatch warning
  stack: [Nuxt 4, Vue 3, TypeScript, Bun, Turborepo, MCP, Supabase]
  status: S44 CLOSED 2026-08-25 — upstream PR built on real develop; see upstream_pr below.
  # POST-S44 STATE 2026-10-01 — see post_s44_state below. Loop still closed; PR still unpushed;
  #   live checkout carries large uncommitted / unpushed work not recorded at S44 close.
  #   S43 CLOSED 2026-08-24 — THE LOOP CLOSED. chat -> Accept -> HUMAN gate -> daemon -> claude-cli
  #   build -> boot-verify -> app serving, observed end to end on 2026-08-24 (apps/app2 on :3007).
  #   This answers S41-F08, outstanding since July. The output is model-authored, not mock: the
  #   generated code follows the repo's `// SEE: feature` convention and its QA doc records real
  #   numeric verification. Evidence: apps/app2/.git (scaffold + pre/post-task commits + wc/<id>-done
  #   tags), the board's activity (1 human gate.opened, 4 build.start, 10 write_file, 4 build.done,
  #   2 boot.ok, 0 boot.fail), and the running process on :3007.
  # STILL OWED (S43-T02 residue): the captured evidence pack, the S41-F08/T03 + S36 [~] flips, one
  #   captured stream-json fixture, and S43-F08 (explain the run's record shape before citing it).
  # NOTE: the pre-S43 corpus WAS mock (39-for-39 plannerMock fingerprint, preserved in
  #   <planning-home>/CORPUS-PROVENANCE-EVIDENCE.md). That history stands. What changed is that it
  #   is now history rather than the whole story.

# ── UPSTREAM PR (S44 CLOSED 2026-08-25) — read this before touching anything upstream ────────
upstream_pr:
  branch: feat/work-control-base-app
  head: 880f16f3
  base: bd1d8199            # app-agent-io/core origin/develop, fetched 2026-08-25
  target: develop           # ci.yml runs FULL CI on PRs into develop; mark the PR ready, not draft
  worktree: ../../../../app-agent-io/DAWWWB-app-agent-dev   # remote `upstream` added there
  shape: layer-only at core/work-control/ — NO root thin app
  commits: [235f1acc layer, ccbdf85b DEV_FACING, 66aecea9 F09 guard test, 880f16f3 §9 alternatives]
  companion: chore/disable-turbo-telemetry @ 3e040aa5
  body: <planning-home>/evidence/S44/PR-BODY.md
  pushed: false             # STILL false as of 2026-10-01 — the push and the merge remain a human act
  ci: all gates exit 0 on a fresh clone; vitest exit 1 = 2 admin:nuxt toaster-a11y tests that
  #   FAIL IDENTICALLY on pristine upstream develop — pre-existing, not ours.

  # ── DEAD ENDS. Do not resurrect. ──────────────────────────────────────────────────────────
  abandoned: pr/work-control-base-app @ 2111ebf
  #   Base 974e43b was main HEAD *two fetches ago* (2026-06-11): 588 behind main, 900 behind
  #   develop. Its shape mirrored control/ over core/control/ — a pattern upstream RETIRED on
  #   2026-07-09 in 9115055b ("Nobody adopted the standalone control plane"). Its `work-control/`
  #   thin app was dropped; upstream's root has no thin app and apps/ is .gitkeep only.

  # ── UPSTREAM FACTS THAT KEEP GETTING READ WRONG ───────────────────────────────────────────
  # ALWAYS `git fetch` /Projects/app-agent-io/core before quoting any upstream number. Every
  # upstream fact S44 was planned on was false because that mirror had never been fetched.
  # UPDATED 2026-10-01: mirror re-fetched 2026-09-02. develop is now 643 AHEAD of main (was 317
  # at S44 close). Base bd1d8199 is therefore STALE relative to current upstream develop.
  develop_vs_main: "643 ahead"   # main...develop after 2026-09-02 fetch — develop is the ACTIVE branch.
  #   Prior S44 figure was 317 ahead (fetched 2026-08-25). Do not quote 317 anymore.
  #   NEVER ask the maintainer to fast-forward develop to main: it would destroy hundreds of commits.
  #   `9a9309d "Initial commit"` is the FORK's develop, not upstream's.
  ci_typecheck: unfiltered (`bunx turbo run typecheck`) — new workspaces ARE reached
  ci_steps: 11, not 6 — adds wiki-drift, baseline-growth, i18n parity, component-manifest
  #   freshness, conformance freshness. Draft PRs are skipped entirely.
  ci_build_gap: `bun run build` filters ./apps/* (empty) — NO CI step builds the layer
  retired_upstream: [control/, core/control/, core/docs/server/, demos/, packages/* workspace]
  #   core/admin + core/api are the live layer precedents; apps/api (3002) + apps/admin (3003)
  #   are scaffolded into apps/ by the launcher on first run. RESERVED_PORTS must reflect that.
  decisions: <planning-home>/decisions/S44-R{1,2,3}-*.md
  summary: <planning-home>/S44-SUMMARY.md

