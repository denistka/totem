    tasks:
      - S90-T5-login-objects-screens.pd
      - S90-T6-object-details-screens.pd
      - S90-T7-settings-reports-screens.pd
      - S90-T8-map-tracking-screens.pd
    requires: [FRONTEND_DEV]
    gate: OPEN

  - id: T4
    title: End-to-end journeys
    tasks:
      - S90-T9-e2e-journeys.pd
    requires: [FRONTEND_DEV, QA]
    gate: OPEN
